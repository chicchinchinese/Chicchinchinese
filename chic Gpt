  accentYellow: '#f7e19c',
};

// Simple CSV parser (expects well-formed simple CSV). Handles CRLF or LF newlines.
function parseCSV(text) {
  if (!text) return { header: [], rows: [] };
  // Normalize newlines and split
  const lines = text.trim().split(/\r?\n/).filter(l => l.trim() !== '');
  if (lines.length === 0) return { header: [], rows: [] };
  const header = lines[0].split(',').map(h => h.trim());
  const rows = lines.slice(1).map(line => {
    // naive split by comma (does not fully support quoted commas)
    const cols = line.split(',').map(c => c.trim().replace(/^"|"$/g, ''));
    const obj = {};
    header.forEach((h, i) => { obj[h] = cols[i] ?? ''; });
    return obj;
  });
  return { header, rows };
}

function formatCSV(rows, header) {
  const h = header.join(',');
  const lines = rows.map(r => header.map(k => `"${String(r[k] ?? '').replace(/"/g, '""')}"`).join(','));
  return [h, ...lines].join('\n');
}

