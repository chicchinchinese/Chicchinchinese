function VocabLibrary({ data, setData }) {
  const levels = Object.keys(data);
  const [selection, setSelection] = useState(levels[0] || 'HSK1');
  const list = data[selection] || [];

  function handleFileUpload(e) {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      try {
        const { rows } = parseCSV(String(ev.target.result || ''));
        const normalized = rows.map(r => {
          const c = (r.chinese || r.Chinese || r.CHINESE || '').trim();
          const p = (r.pinyin || r.Pinyin || '').trim();
          const t = (r.thai || r.Thai || '').trim();
          const eWord = (r.english || r.English || r.en || '').trim();
          return { chinese: c, pinyin: p, thai: t, english: eWord };
        });
        setData(prev => ({ ...prev, [selection]: normalized }));
        safeSaveToLocal({ ...safeLoadFromLocal(), [selection]: normalized } || { ...DEMO_DATA, [selection]: normalized });
        alert(`Imported ${normalized.length} items into ${selection}`);
      } catch (err) {
        console.error(err);
        alert('Failed to parse CSV — ensure header includes chinese,pinyin,thai,english');
      }
    };
    reader.readAsText(file, 'UTF-8');
  }

  function exportSelection() {
    const header = ['chinese', 'pinyin', 'thai', 'english'];
    const csv = formatCSV(list, header);
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${selection}_vocab.csv`;
    a.click();
    URL.revokeObjectURL(url);
  }

  return (
    <section style={{ maxWidth: 1200, margin: '24px auto', padding: 16 }}>
      <h2 style={{ color: COLORS.deepMaroon }}>Vocab Library</h2>
      <p style={{ color: COLORS.darkMaroonText }}>อัปโหลดไฟล์ CSV เพื่อเติมคำศัพท์เต็มสำหรับแต่ละระดับ (header: chinese,pinyin,thai,english)</p>
      <div style={{ display: 'flex', gap: 8, marginTop: 12 }}>
        {levels.map(l => (
          <button key={l} onClick={() => setSelection(l)} style={{ padding: '8px 10px', borderRadius: 8, background: selection === l ? COLORS.deepMaroon : 'transparent', color: selection === l ? COLORS.pastelYellow : COLORS.darkMaroonText, border: `1px solid ${COLORS.deepMaroon}` }}>{l}</button>
        ))}
      </div>
      <div style={{ marginTop: 12, background: 'white', padding: 12, borderRadius: 10 }}>
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
          <div>
            <strong style={{ color: COLORS.deepMaroon }}>{selection}</strong>
            <div style={{ color: COLORS.darkMaroonText }}>{list.length} words</div>
          </div>
          <div style={{ display: 'flex', gap: 8 }}>
            <label style={{ padding: '8px 12px', borderRadius: 8, border: `1px dashed ${COLORS.deepMaroon}`, cursor: 'pointer' }}>
              Upload CSV
              <input type="file" accept=".csv" style={{ display: 'none' }} onChange={handleFileUpload} />
            </label>
            <button onClick={exportSelection} style={{ padding: '8px 12px', borderRadius: 8, background: COLORS.deepMaroon, color: COLORS.pastelYellow }}>Download CSV</button>
          </div>
        </div>

        <div style={{ marginTop: 12, display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))', gap: 8 }}>
          {list.slice(0, 200).map((v, idx) => (
            <div key={idx} style={{ padding: 10, borderRadius: 8, border: '1px solid #eee' }}>
              <div style={{ fontSize: 20, fontWeight: 700, color: COLORS.deepMaroon }}>{v.chinese}</div>
              <div style={{ color: COLORS.darkMaroonText }}>{v.pinyin}</div>
              <div style={{ color: COLORS.darkMaroonText, marginTop: 6 }}>{v.thai} — <span style={{ color: '#6b2e2e' }}>{v.english}</span></div>
            </div>
          ))}
          {list.length === 0 && <div style={{ color: COLORS.darkMaroonText }}>No words in this level yet — upload a CSV or let us populate it for you.</div>}
        </div>
      </div>
    </section>
  );
}

