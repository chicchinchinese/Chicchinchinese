        <UsefulVocab usefulData={usefulData} setUsefulData={setUsefulData} />
      )}

      {route === 'about' && (
        <About teacher={{ name: 'Noey', bio: 'ครูผู้มีประสบการณ์สอนภาษาจีนให้คนไทย' }} />
