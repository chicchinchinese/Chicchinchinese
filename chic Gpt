    const file = e.target.files && e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      try {
        const { rows } = parseCSV(String(ev.target.result || ''));
        const normalized = rows.map(r => ({ chinese: (r.chinese || '').trim(), pinyin: (r.pinyin || '').trim(), thai: (r.thai || '').trim(), english: (r.english || '').trim() }));
        setUsefulData(prev => ({ ...prev, [cat]: normalized }));
